# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash

# STT (Speech to Text) Configuration (assemblyai, gemini, whisper, etc.)
STT_PROVIDER=assemblyai
STT_API_KEY=
ASSEMBLYAI_API_KEY=
STT_MODEL=assemblyai-conformer-2

# TTS: gTTS (Google Translate's text-to-speech) is the voice engine — keyless,
# no model download. Left here only so the stage can be disabled on purpose.
GTTS_ENABLED=true

# Translation: Google Translate's free endpoint (what googletrans uses) — keyless.
GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_CONCURRENCY=6

# Sync: pull an overflowing dubbed line back into the slot it was spoken in.
DUB_SYNC_ENABLED=true
DUB_SYNC_MAX_TEMPO=1.75

# Audio Separation Configuration (local_dsp, demucs, replicate)
AUDIO_SEPARATION_PROVIDER=local_dsp
AUDIO_SEPARATION_API_KEY=

# S3-compatible / Cloudflare R2 Storage Configuration
# Cloudflare R2 Endpoint: https://c838eceff526b328e8385736a138fb6b.r2.cloudflarestorage.com/061
S3_ENDPOINT=https://c838eceff526b328e8385736a138fb6b.r2.cloudflarestorage.com
S3_BUCKET=061
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Video Processing Parameters
MAX_VIDEO_SIZE_MB=500
VIDEO_SEGMENT_SECONDS=300

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
